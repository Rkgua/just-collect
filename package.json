{
  "name": "just-collect",
  "version": "1.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "expo export --platform web && playwright test",
    "check:api": "tsx scripts/check-bilibili.ts",
    "icons": "node scripts/generate-icons.cjs",
    "format": "prettier --write .",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.1.0",
    "expo-brightness": "~58.0.3",
    "expo-clipboard": "~58.0.4",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.19.0",
    "@types/react": "~19.3.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
